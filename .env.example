# Open Factory Environment Configuration (Optional)
# Copy to .env if you wish to override defaults:
# cp .env.example .env

# GitHub Personal Access Token (with 'repo' & 'workflow' scope)
# If omitted, ./factory will auto-detect from `gh auth token` or prompt interactively
GITHUB_TOKEN=

# Dashboard Server Port (default: 8080)
PORT=8080

# OpenHands Engine Configuration
# Mode: 'local' (default, runs on 127.0.0.1:8000) or 'cloud' (https://app.all-hands.dev)
OPENHANDS_MODE=local
OPENHANDS_BASE_URL=http://127.0.0.1:8000
OPENHANDS_API_KEY=

# OpenHands Cloud (All-Hands.dev) Settings:
# OPENHANDS_MODE=cloud
# OPENHANDS_CLOUD_API_KEY=oh_api_pat_...
# OPENHANDS_CLOUD_BASE_URL=https://app.all-hands.dev
